HOST=127.0.0.1
PORT=4000
LOG_LEVEL=info

SQLITE_PATH=./data/minidog.sqlite

CLICKHOUSE_URL=http://127.0.0.1:8123
CLICKHOUSE_USER=minidog
CLICKHOUSE_PASSWORD=minidog
CLICKHOUSE_DATABASE=minidog

# Runs the synthetic check scheduler inside the API process.
WORKER_ENABLED=true
WORKER_CONCURRENCY=8

# Evaluates alert monitors inside the API process.
ALERTS_ENABLED=true
ALERT_INTERVAL_SECONDS=30

# OTLP requests without an API key go to the default project unless this is true.
INGEST_REQUIRE_API_KEY=false

# Shown as connection info in Settings.
PUBLIC_API_URL=http://localhost:4000
PUBLIC_COLLECTOR_URL=http://localhost:4318

# Synthetic checks and webhooks never reach link-local or cloud metadata addresses.
# On a shared server, also keep them off private and loopback networks.
BLOCK_PRIVATE_TARGETS=false

# Dashboard sign-in (a password set on first run). Only disable it on a machine nobody else can reach.
AUTH_DISABLED=false
