<!--
  Single-node settings for a personal deployment: quieter logs and no
  high-volume system log tables that would otherwise dominate disk usage.
-->
<clickhouse>
  <logger>
    <level>warning</level>
    <console>1</console>
  </logger>

  <query_thread_log remove="1" />
  <part_log remove="1" />
  <trace_log remove="1" />
  <metric_log remove="1" />
  <asynchronous_metric_log remove="1" />
  <text_log remove="1" />
  <processors_profile_log remove="1" />
</clickhouse>
